# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files (API keys, secrets)
.env
.env.*
!.env.example

# Code generation
*.freezed.dart
*.g.dart
!lib/core/database/**/*.g.dart
*.chopper.dart
*.mocks.dart

# Coverage
/coverage/

# Android signing
/android/key.properties
/android/app/key.properties
/android/*.jks

# FVM Version Cache
.fvm/
*/*.temp
# Dumps locais do banco (ver tool/backup/)
/backups/

# Configuração pessoal de ferramentas que nada têm a ver com o Memora e que
